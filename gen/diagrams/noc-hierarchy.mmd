  n_compute0_local_config -->|global control| n_global_config
  subgraph n_compute1_box["compute1 / compute subsystem"]
  n_compute1_cpu["serv CPU"]:::model
  n_compute1_dma["PULP iDMA + CSR (DmaEnable=1)"]:::model
  n_compute1_sram["Local SRAM"]:::model
  n_compute1_local_data["Local DATA FlooNoC / 6 routers / AXI4"]:::data
  n_compute1_local_config["Local CONFIG FlooNoC / 4 routers / 32-bit AXI4 transport"]:::config
  end
  n_compute1_cpu -->|CPU adapter| n_compute1_local_data
  n_compute1_dma -->|DMA AXI4| n_compute1_local_data
  n_compute1_local_data -->|local| n_compute1_sram
  n_compute1_cpu -->|AXI-Lite bridge| n_compute1_local_config
  n_compute1_local_data -->|global data| n_global_data
  n_compute1_local_config -->|global control| n_global_config
  subgraph n_pcie0_box["pcie0 / verilog_pcie subsystem"]
  n_pcie0_ip["verilog_pcie bridge (reserved)"]:::model
  n_pcie0_sram["Local SRAM RTL"]:::model
  n_pcie0_csr["Reserved CSR (AXI error)"]:::model
  n_pcie0_local_data["Local DATA FlooNoC / 4 routers / AXI4"]:::data
  n_pcie0_local_config["Local CONFIG FlooNoC / 4 routers"]:::config
