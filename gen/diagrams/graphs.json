        "command": "make dv-boot",
        "dut": "compute0.cpu+compute1.cpu+boot_rom+flash+sram+reset_ctrl",
        "id": "cpu_cold_boot",
        "label": "cpu_cold_boot\nDUT: compute0.cpu+compute1.cpu+boot_rom+flash+sram+reset_ctrl\nmake dv-boot\ncpu0_rom_fetch, flash_to_sram_stores, secondary_reset_release",
