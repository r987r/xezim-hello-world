flowchart TB
  classDef cpu fill:#e8f0fe,stroke:#2869c9,color:#172a4b,stroke-width:1px;
  classDef dma fill:#e7f2ff,stroke:#2869c9,color:#172a4b,stroke-width:1px;
  classDef fabric fill:#e3f4ec,stroke:#20824e,color:#153c26,stroke-width:1px;
  classDef memory fill:#fff0e6,stroke:#c46b2f,color:#563115,stroke-width:1px;
  classDef config fill:#f1edff,stroke:#7654b5,color:#342451,stroke-width:1px;
  classDef verification fill:#e3f4ec,stroke:#20824e,color:#153c26,stroke-width:1px;
  classDef model fill:#f2f2f2,stroke:#888888,color:#333333,stroke-width:1px;
  por["Power-on reset<br/>CPU0 running / CPU1 held"]:::config
  bootrom["CPU0 executes Boot ROM<br/>0x00000000 / immutable model"]:::cpu
  flash["Read-only flash image MODEL<br/>0x20000000 / ROM preloaded from hex"]:::memory
  sram0["Blank SRAM0 -&gt; firmware<br/>0x10000000 / AXI4-Lite stores"]:::memory
  sram1["Blank SRAM1 -&gt; firmware<br/>0x11000000 / AXI4-Lite stores"]:::memory
  resetctrl["Reset-control MMIO<br/>0x40020000 = 1"]:::config
  c0prog["CPU0 runs SRAM0<br/>writes signature 0x55"]:::verification
  c1prog["CPU1 released -&gt; runs SRAM1<br/>writes signature 0x66"]:::verification
  future["Future: SPI/QSPI + image validation + full-chip NoC"]:::model
  por -->|CPU0 reset PC| bootrom
  bootrom -->|CPU0 reads firmware words| flash
  flash -->|CPU0 copies image0| sram0
  flash -->|CPU0 copies image1| sram1
  bootrom -->|MMIO release after copy| resetctrl
  resetctrl -->|release SERV reset| c1prog
  sram0 -->|CPU0 jump| c0prog
  sram1 -->|CPU1 instruction fetch| c1prog
  flash -.->|real flash controller not integrated| future
